{# CST Analysis Report — one A4 portrait page #}
{# Context is assembled by reports.build_report_context() #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CST Analysis Report</title>
    <style>{{ css }}</style>
</head>
<body>
<div class="page">

    {# ===== Header ===== #}
    <header class="header">
        <div class="header-left">
            <h1>CST Analysis Report</h1>
            <p class="meta">
                Subject: <strong>{{ subject_id }}</strong>
                <span class="sep">|</span>
                Date: <strong>{{ date }}</strong>
                <span class="sep">|</span>
                Method: <strong>{{ method_summary }}</strong>
            </p>
        </div>
        <div class="header-right">
            <div class="legend">
                <span class="swatch left"></span>Left CST
                <span class="swatch right"></span>Right CST
            </div>
            <div class="li-formula">LI = (L - R) / (L + R)</div>
            <div class="li-signs">
                <span class="li-left">LI &gt; 0 · Left-dominant</span>
                <span class="li-right">LI &lt; 0 · Right-dominant</span>
            </div>
        </div>
    </header>

    {# ===== Methods band (3 columns) ===== #}
    {# Rows are flex, not a CSS grid: the band is content-sized and its height #}
    {# must be predictable in WeasyPrint for the one-page budget. #}
    <section class="methods-band">
        {% for title, rows in [("Acquisition", acq_rows),
                               ("Processing", proc_rows),
                               ("Space &amp; Orientation", space_rows)] %}
        <div class="method-col">
            <h2>{{ title }}</h2>
            {% for label, value in rows %}
            <div class="mrow"><span class="mk">{{ label }}</span><span class="mv">{{ value }}</span></div>
            {% endfor %}
        </div>
        {% endfor %}
    </section>

    {# ===== Global metrics ===== #}
    <section class="global-metrics">
        <h2 class="section-title">Global metrics <small>Diffusivity units: mm²/s (×10⁻³)</small></h2>
        <table class="metrics-table">
            <thead>
                <tr>
                    <th class="col-metric">Metric</th>
                    <th>Left Mean ± SD</th>
                    <th>Right Mean ± SD</th>
                    <th>Left Median (min–max)</th>
                    <th>Right Median (min–max)</th>
                    <th class="col-li">LI</th>
                </tr>
            </thead>
            <tbody>
                {% for m in metrics %}
                <tr>
                    <td class="metric-label">{{ m.label }}</td>
                    <td>{{ m.left_mean_sd }}</td>
                    <td>{{ m.right_mean_sd }}</td>
                    <td>{{ m.left_med_range }}</td>
                    <td>{{ m.right_med_range }}</td>
                    <td class="li {{ m.li_class }}">{{ m.li }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    {# ===== Regional metrics ===== #}
    <section class="regional-metrics">
        {# Node homology rides on this existing caption row rather than in a #}
        {# block of its own: measured, the block cost 3 mm the page did not #}
        {# have. Descriptive only — the regional values below are never #}
        {# suppressed, greyed or annotated with a verdict, and no validated #}
        {# threshold exists to annotate them with. #}
        <h2 class="section-title">Regional metrics
            {% if node_homology.available %}
            <small class="homology-note">Node homology — max L–R node offset {{ node_homology.max_abs_z_mm }} mm ·
                mean length difference {{ node_homology.length_diff_mm }} mm</small>
            {% else %}
            <small class="homology-note">Node homology — unavailable (one hemisphere has no streamlines)</small>
            {% endif %}
        </h2>
        <table class="regional-table">
            <thead>
                <tr>
                    <th class="col-region">Region</th>
                    <th>FA (L / R / LI)</th>
                    <th>MD (L / R / LI)</th>
                    <th>RD (L / R / LI)</th>
                    <th>AD (L / R / LI)</th>
                </tr>
            </thead>
            <tbody>
                {% for r in localized_metrics %}
                <tr>
                    <td class="region-label">{{ r.name }}</td>
                    <td>{{ r.fa }}</td>
                    <td>{{ r.md }}</td>
                    <td>{{ r.rd }}</td>
                    <td>{{ r.ad }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    {# ===== Along-tract profiles (2x2 matrix) ===== #}
    {# The profile legend is owned by the Matplotlib figure (it has to be placed #}
    {# against the subplot geometry). Do not add a second one here. #}
    <section class="profiles">
        <h2 class="section-title">Along-tract profiles</h2>
        {% if profile_matrix %}
        <img class="profile-matrix" src="{{ profile_matrix }}" alt="Along-tract profile matrix (FA, MD, RD, AD)">
        {% else %}
        <div class="figure-placeholder">[Along-tract profiles]</div>
        {% endif %}
    </section>

    {# ===== Tractography QC (1x4 strip, one shared coronal slice) ===== #}
    {# Each panel's key is owned by the Matplotlib figure, which is the only #}
    {# thing that knows where the panels landed. Do not add legends here. #}
    {# The slice and the rule that chose it live in the figure's caption. #}
    {# No subtitle: "FA background" was true of panels 2-4 only — panel 1 is #}
    {# the DEC image itself, not an overlay on FA — and each panel now names #}
    {# its own content in its own key. #}
    <section class="qc">
        <h2 class="section-title">Tractography QC</h2>
        {% if qc_strip %}
        <img class="qc-strip" src="{{ qc_strip }}" alt="Report QC strip (DEC-FA, CST density, extraction ROIs, CST over FA)">
        {% else %}
        <div class="figure-placeholder">[Tractography QC]</div>
        {% endif %}
    </section>

    {# ===== Provenance footer ===== #}
    {# Fixed three lines, one proportional face throughout, a fixed dependency #}
    {# subset (no open-ended list), and each line clipped horizontally so an #}
    {# unusually long CPU/platform string can never grow the footer. #}
    <footer class="footer">
        <h2 class="footer-title">Reproducibility</h2>
        {% if provenance %}
        <p class="footer-line">
            <strong>csttool v{{ version }}</strong>
            <span class="sep">|</span> Python {{ provenance.python_version }}
            <span class="sep">|</span> {{ provenance.platform }}
            <span class="sep">|</span> {{ provenance.hardware_str }}
        </p>
        <p class="footer-line">{{ provenance.thread_env_str }}</p>
        <p class="footer-line">{{ provenance.dependencies_str }}</p>
        {% else %}
        <p class="footer-line">Provenance information was not recorded for this run.</p>
        <p class="footer-line">&nbsp;</p>
        <p class="footer-line">&nbsp;</p>
        {% endif %}
    </footer>

</div>
</body>
</html>
